        <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
        <Param name="Before Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="Begin Experiment" val="inst_audio = None&#10;" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="Begin Routine" val="if args.skip_instructions:&#10;    continueRoutine = False&#10;else:&#10;    markers.send('instruction_start', 101)&#10;    inst_img = str(assets['language'] / 'InstructionLevel1.PNG')&#10;    instruction_image.setImage(inst_img)&#10;    if args.audio_instructions:&#10;        inst_audio_path = assets['language'] / 'InstructionLevel1.mp3'&#10;        if inst_audio_path.exists():&#10;            try:&#10;                inst_audio = sound.Sound(str(inst_audio_path))&#10;                inst_audio.play()&#10;            except Exception:&#10;                inst_audio = None&#10;" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="End Routine" val="markers.send('instruction_end', 102)&#10;if 'inst_audio' in locals() and inst_audio:&#10;    inst_audio.stop()&#10;" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="End Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
      </CodeComponent>
