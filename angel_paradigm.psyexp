                <Param name="Code Type" val="Py" valType="str" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="Before Experiment" val="import angel_paradigm_coder as engine&#10;args = engine.parse_args()&#10;args = engine.show_config_dialog(args)&#10;engine.CURRENT_ARGS = args&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Experiment" val="import random as std_random&#10;args = engine.CURRENT_ARGS&#10;levels = [level.strip() for level in args.levels.split(&quot;,&quot;) if level.strip()]&#10;engine.validate_config(args)&#10;&#10;# Populate KEYS so slides respond to keypresses&#10;engine.KEYS[&quot;left&quot;] = engine.parse_keys_list(args.left_keys)&#10;engine.KEYS[&quot;right&quot;] = engine.parse_keys_list(args.right_keys)&#10;engine.KEYS[&quot;continue&quot;] = engine.parse_keys_list(getattr(args, &quot;continue_keys&quot;, &quot;any&quot;))&#10;engine.KEYS[&quot;trigger&quot;] = engine.parse_keys_list(args.trigger_keys)&#10;KEYS = engine.KEYS&#10;&#10;exp_clock = core.Clock()&#10;markers = engine.MarkerSender(args, core, exp_clock)&#10;rng = std_random.Random(args.seed)&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="# Stop and delete all cached audio objects so Core Audio&#39;s HALC dispatch&#10;# queue can drain before Python exits (prevents SIGILL crash on macOS).&#10;try:&#10;    for _snd in list(audio_cache.values()):&#10;        _snd.stop()&#10;    audio_cache.clear()&#10;except (NameError, Exception):&#10;    pass&#10;import time as _time&#10;_time.sleep(0.5)  # Allow Core Audio listener thread to drain&#10;markers.close()&#10;" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Before JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Begin JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="Each JS Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End JS Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
            </CodeComponent>
