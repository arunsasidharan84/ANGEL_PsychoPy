        <Param name="name" val="trigger_text" valType="code" updates="constant" plugin="None"/>
        <Param name="text" val="Waiting for scanner trigger..." valType="str" updates="constant" plugin="None"/>
        <Param name="pos" val="(0, 0)" valType="list" updates="constant" plugin="None"/>
