                <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
                <Param name="End Experiment" val="# Stop and delete all cached audio objects to drain Core Audio HALC queue&#10;try:&#10;    for _snd in list(audio_cache.values()):&#10;        _snd.stop()&#10;    audio_cache.clear()&#10;except (NameError, Exception):&#10;    pass&#10;import time as _time&#10;_time.sleep(0.5)&#10;markers.close()&#10;" valType="extendedCode" updates="constant" plugin="None"/>
