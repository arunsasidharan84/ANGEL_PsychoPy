        <Param name="stopType" val="duration (s)" valType="str" updates="constant" plugin="None"/>
        <Param name="stopVal" val="$args.slide_timeout if 'args' in locals() and args.slide_timeout &gt; 0 else ''" valType="code" updates="constant" plugin="None"/>
        <Param name="forceEndRoutine" val="True" valType="bool" updates="constant" plugin="None"/>
