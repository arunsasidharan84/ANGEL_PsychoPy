        <Param name="Begin Experiment" val="" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="Begin Routine" val="if not getattr(args, 'show_feedback', True):&#10;    continueRoutine = False&#10;else:&#10;    if getattr(args, 'passive_mode', False):&#10;        feedback_text.setText('Session Complete!\n\nContinuing automatically...')&#10;" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="Each Frame" val="" valType="extendedCode" updates="constant" plugin="None"/>
        <Param name="End Routine" val="" valType="extendedCode" updates="constant" plugin="None"/>
